<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <Compile Update="Forms\LoginForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\LoginForm.Designer.cs"><DependentUpon>LoginForm.cs</DependentUpon></Compile>
    <Compile Update="Forms\MainForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <Compile Update="Forms\EditorForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Forms\EditorForm.Designer.cs"><DependentUpon>EditorForm.cs</DependentUpon></Compile>
    <Content Include="..\..\server.py;..\..\gameplay.py;..\..\desktop_host.py"><Link>backend\%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="..\..\static\**\*"><Link>backend\static\%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
  </ItemGroup>
</Project>
